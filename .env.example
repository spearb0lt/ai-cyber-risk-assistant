# =============================================================================
# AI Cyber Risk Assistant - environment
# Copy to .env and fill in whatever you have. Nothing here is required.
# =============================================================================
#
# The system produces the full top-5 risk analysis with NO keys at all:
# ranking, KEV cross-referencing and NIST retrieval are deterministic and run
# locally. A key only upgrades the written narrative from a generated template
# to LLM prose. So a deployment with an empty .env still works end to end.
#
# Seven providers are supported. Every model id listed in the comments below is
# also selectable at runtime from the model picker in the UI, which is filled by
# asking each provider what the key can actually call. These lists are a
# starting point, not a limit: set <PROVIDER>_MODEL to make one the default, or
# <PROVIDER>_EXTRA_MODELS to add ids the picker does not discover on its own.

# -----------------------------------------------------------------------------
# 1. OpenRouter                                      https://openrouter.ai/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_EXTRA_MODELS=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# Models that cost nothing, from https://openrouter.ai/models?q=free
# The ":free" suffix is what makes an id free; the same model without it is
# billed. Verified against the live /api/v1/models catalogue on 2026-09-15.
# Context window shown in thousands of tokens.
#
#   cohere/north-mini-code:free                          256k   Cohere North Mini Code
#   dots-studio/dots-3-note-preview:free                 512k   Dots Studio Dots3-Note Preview
#   google/gemma-4-26b-a4b-it:free                       262k   Google Gemma 4 26B A4B
#   google/gemma-4-31b-it:free                           262k   Google Gemma 4 31B
#   inclusionai/ling-3.0-flash-fin:free                  262k   inclusionAI Ling 3.0 Flash Fin
#   inclusionai/ling-3.0-flash-sante:free                262k   inclusionAI Ling 3.0 Flash Sante
#   inclusionai/ling-3.0-flash-vl:free                   262k   inclusionAI Ling 3.0 Flash VL
#   liquid/lfm-2.5-2.6b:free                              65k   LiquidAI LFM2.5-2.6B
#   nex-agi/nex-n2.5-mini:free                           262k   Nex AGI Nex-N2.5-Mini
#   nex-agi/nex-n2.5-pro:free                            262k   Nex AGI Nex-N2.5-Pro
#   nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free   256k   NVIDIA Nemotron 3 Nano Omni
#   nvidia/nemotron-3-super-120b-a12b:free               262k   NVIDIA Nemotron 3 Super
#   nvidia/nemotron-3-ultra-550b-a55b:free              1000k   NVIDIA Nemotron 3 Ultra
#   nvidia/nemotron-3.5-content-safety:free              128k   NVIDIA Nemotron 3.5 Content Safety
#   nvidia/nemotron-3.5-lightning:free                  1000k   NVIDIA Nemotron 3.5 Lightning
#   poolside/laguna-s-2.1:free                           262k   Poolside Laguna S 2.1
#   poolside/laguna-xs-2.1:free                          262k   Poolside Laguna XS 2.1
#   thinkingmachines/inkling-small:free                 1048k   Thinking Machines Inkling Small
#   thinkingmachines/inkling:free                       1048k   Thinking Machines Inkling
#
# Free models are rate limited and are occasionally withdrawn without notice,
# so treat this list as accurate on the day it was generated. Re-check with:
#   curl -s https://openrouter.ai/api/v1/models > m.json
#   python -c "import json;print(*[m['id'] for m in json.load(open('m.json'))['data'] if m['id'].endswith(':free')],sep='\n')"

# -----------------------------------------------------------------------------
# 2. Google Gemini                          https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EXTRA_MODELS=
#
#   gemini-2.5-flash        Balanced default, generous free tier
#   gemini-2.5-pro          Deepest reasoning
#   gemini-2.5-flash-lite   Fastest and cheapest
#   gemini-2.0-flash        Previous generation, still on the free tier

# -----------------------------------------------------------------------------
# 3. Groq                                      https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_EXTRA_MODELS=
#
#   openai/gpt-oss-120b                             Strongest reasoning here
#   openai/gpt-oss-20b                              Fastest
#   llama-3.3-70b-versatile                         Strong general default
#   llama-3.1-8b-instant                            Lowest latency
#   groq/compound                                   Tool augmented
#   meta-llama/llama-4-scout-17b-16e-instruct       Multimodal, long context
#   meta-llama/llama-4-maverick-17b-128e-instruct   Multimodal, largest context

# -----------------------------------------------------------------------------
# 4. OmniRouter                                         https://omnirouter.li
# -----------------------------------------------------------------------------
# An OpenAI compatible gateway fronting many providers. Its catalogue changes
# constantly, so there is no fixed list here: the picker is filled entirely
# from whatever the key can actually call.
OMNIROUTER_API_KEY=
# OMNIROUTER_MODEL=
# OMNIROUTER_EXTRA_MODELS=
# OMNIROUTER_BASE_URL=https://omnirouter.li/v1

# -----------------------------------------------------------------------------
# 5. Cloudflare Workers AI      https://dash.cloudflare.com/profile/api-tokens
# -----------------------------------------------------------------------------
# BOTH values are needed. The account id is part of the request URL, so a token
# on its own cannot address anything. The token needs the Workers AI permission.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b
# CLOUDFLARE_EXTRA_MODELS=
#
#   @cf/openai/gpt-oss-120b                     128k context, strongest here
#   @cf/meta/llama-3.3-70b-instruct-fp8-fast     24k context, quick default
#   @cf/meta/llama-4-scout-17b-16e-instruct     131k context, multimodal
#   @cf/qwen/qwen3-30b-a3b-fp8                   32k context

# -----------------------------------------------------------------------------
# 6. OpenAI, or any OpenAI compatible gateway
#                                       https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
# Point this at Ollama, LM Studio, vLLM or LiteLLM with OPENAI_BASE_URL. For a
# local Ollama the key can be any non-empty string.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EXTRA_MODELS=
#
#   gpt-4o-mini    Fast and inexpensive
#   gpt-4o         Highest quality
#   gpt-4.1-mini   Cheap, large context
#   gpt-4.1        Large context

# -----------------------------------------------------------------------------
# 7. Hugging Face                     https://huggingface.co/settings/tokens
# -----------------------------------------------------------------------------
# The token needs inference permission.
HUGGINGFACE_API_KEY=
# HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct
# HUGGINGFACE_EXTRA_MODELS=
# HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
#
#   meta-llama/Llama-3.3-70B-Instruct   Strong general default
#   Qwen/Qwen2.5-72B-Instruct           Strong general alternative
#   deepseek-ai/DeepSeek-V3-0324        Long context
#   Qwen/Qwen2.5-VL-7B-Instruct         Multimodal

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# "local" runs BAAI/bge-small-en-v1.5 through ONNX here and needs no key.
# "gemini" uses the Gemini embedding API and needs GEMINI_API_KEY.
# The committed index was built with "local", so switching needs a rebuild:
#   python scripts/build_index.py --embedder gemini
# EMBEDDER=local
# LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
# GEMINI_EMBED_MODEL=gemini-embedding-001
#
# Where fastembed keeps the ONNX weights. fastembed does NOT honour HF_HOME, so
# this is the only way to control it. The Docker image sets it to /opt/models
# and bakes the model in at build time.
# EMBED_CACHE_DIR=

# -----------------------------------------------------------------------------
# Bring your own key
# -----------------------------------------------------------------------------
# 1 (default) lets a visitor paste their own key in the UI. It is held in their
# browser, sent as a request header, used for their own calls only, and never
# stored on the server.
# Set to 0 for a private deployment that runs only on the keys above.
# ALLOW_CLIENT_KEYS=1

# -----------------------------------------------------------------------------
# Tuning
# -----------------------------------------------------------------------------
# TOP_N=5                     how many risks the brief reports
# MAX_RISKS_PER_SERVICE=1     diversity cap so one service cannot fill the list
# REQUEST_TIMEOUT=120
# CORS_ORIGINS=https://your-frontend.example.com
# DEBUG=false
