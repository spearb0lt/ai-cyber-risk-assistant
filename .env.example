# =============================================================================
# AI Cyber Risk Assistant - environment
# Copy to .env and fill in whatever you have. Nothing here is required.
# =============================================================================
#
# The system produces the full top-5 risk analysis with NO keys at all:
# ranking, KEV cross-referencing and NIST retrieval are deterministic and run
# locally. A key only upgrades the written narrative from a generated template
# to LLM prose. So a deployment with an empty .env still works end to end.

# --- LLM providers (all optional) --------------------------------------------
# With ALLOW_CLIENT_KEYS on (the default), a visitor can paste their own key in
# the UI instead. Their key is held in their browser, sent as a request header,
# used only for their own requests, and never stored on the server.

# Google Gemini        https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq                 https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter           https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OmniRouter           https://omnirouter.li
OMNIROUTER_API_KEY=

# OpenAI, or any OpenAI compatible gateway (Ollama, LM Studio, vLLM, LiteLLM)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Optional model overrides ------------------------------------------------
# The id named here is moved to the top of that provider's picker.
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OMNIROUTER_MODEL=
# OPENAI_MODEL=gpt-4o-mini

# Add extra model ids to a picker, comma separated.
# GROQ_EXTRA_MODELS=qwen/qwen3-32b

# --- Embeddings --------------------------------------------------------------
# "local" runs BAAI/bge-small-en-v1.5 through ONNX on this machine and needs no
# key. "gemini" uses the Gemini embedding API and needs GEMINI_API_KEY.
# The committed index was built with "local", so switching requires a rebuild:
#   python scripts/build_index.py --embedder gemini
# EMBEDDER=local
# LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Bring your own key ------------------------------------------------------
# 1 (default) lets a visitor paste their own key in the UI.
# Set to 0 for a private deployment that runs only on the keys above.
# ALLOW_CLIENT_KEYS=1

# --- Tuning ------------------------------------------------------------------
# TOP_N=5                       how many risks the brief reports
# MAX_RISKS_PER_SERVICE=1       diversity cap so one service cannot fill the list
# REQUEST_TIMEOUT=120
# CORS_ORIGINS=https://your-frontend.example.com
# DEBUG=false
